{
  "name": "hornetsecurity-todo-playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:app": "serve app -l 8080 --no-clipboard",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:knownIssues": "playwright test --grep @known-issue",
    "test:regression": "playwright test --grep-invert @known-issue",
    "test:create": "playwright test tests/todoCreate.spec.ts",
    "test:read": "playwright test tests/todoRead.spec.ts",
    "test:update": "playwright test tests/todoUpdate.spec.ts",
    "test:delete": "playwright test tests/todoDelete.spec.ts",
    "test:security": "playwright test tests/todoSecurity.spec.ts",
    "report": "playwright show-report",
    "docker:build": "docker build -t todo-playwright .",
    "docker:test": "docker run --rm --init --ipc=host todo-playwright"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dijanabr/hornetsecurity-todo-playwright.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dijanabr/hornetsecurity-todo-playwright/issues"
  },
  "homepage": "https://github.com/dijanabr/hornetsecurity-todo-playwright#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure-playwright": "^3.14.0",
    "serve": "^14.2.6"
  }
}
